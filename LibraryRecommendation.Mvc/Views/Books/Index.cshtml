@model IEnumerable<LibraryRecommendation.Mvc.Models.BookViewModel>
@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input name="term" value="@ViewData["Term"]" class="form-control" placeholder="Search title, author or genre" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Genre</th>
            <th>Rating</th>
            <th>Year</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var book in Model)
    {
        <tr>
            <td>@book.Title</td>
            <td>@book.Author</td>
            <td>@book.Genre</td>
            <td>@book.Rating</td>
            <td>@book.PublishedYear</td>
            <td>
                <a asp-action="Details" asp-route-id="@book.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@book.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@book.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
